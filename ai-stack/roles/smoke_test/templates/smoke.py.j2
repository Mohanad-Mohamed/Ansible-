#!/usr/bin/env python3
"""Smoke test for the mini AI stack. Runs inside the litellm pod.

Checks, in order:
  1. Chat completion through LiteLLM alias {{ app_contract.chat_model_alias }}
  2. Embedding call through LiteLLM alias {{ app_contract.embedding_model_alias }}
  3. Vector search in Qdrant through the '{{ app_contract.qdrant_collection_alias }}' alias

Exit 0 = all good. Exit 1 = clear error message on stderr.
"""
import json
import os
import sys
import urllib.request
import urllib.error

LITELLM = "http://localhost:4000"
QDRANT = "http://qdrant:6333"
MASTER_KEY = os.environ.get("LITELLM_MASTER_KEY", "")
CHAT_ALIAS = "{{ app_contract.chat_model_alias }}"
EMBED_ALIAS = "{{ app_contract.embedding_model_alias }}"
COLLECTION_ALIAS = "{{ app_contract.qdrant_collection_alias }}"


def post(url, payload, headers=None, timeout=120):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", **(headers or {})},
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def fail(msg):
    print(f"SMOKE TEST FAILED: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    auth = {"Authorization": f"Bearer {MASTER_KEY}"}

    # 1. Chat
    try:
        r = post(f"{LITELLM}/v1/chat/completions", {
            "model": CHAT_ALIAS,
            "messages": [{"role": "user", "content": "Say OK"}],
            "max_tokens": 8,
        }, auth)
        if not r.get("choices"):
            fail("chat: empty response")
        print(f"chat OK: {r['choices'][0]['message'].get('content', '')[:40]!r}")
    except Exception as e:
        fail(f"chat completion via LiteLLM alias '{CHAT_ALIAS}': {e}")

    # 2. Embeddings
    try:
        r = post(f"{LITELLM}/v1/embeddings", {
            "model": EMBED_ALIAS,
            "input": "smoke test",
        }, auth)
        vec = r["data"][0]["embedding"]
        if not vec:
            fail("embeddings: empty vector")
        print(f"embeddings OK: {len(vec)} dims")
    except Exception as e:
        fail(f"embedding call via LiteLLM alias '{EMBED_ALIAS}': {e}")

    # 3. Qdrant search through the alias (read-only; works even with 0 points,
    #    but we require the alias to resolve to an existing collection)
    try:
        with urllib.request.urlopen(f"{QDRANT}/collections/{COLLECTION_ALIAS}", timeout=15) as r:
            info = json.loads(r.read())
        result = info.get("result", {})
        if result.get("status") != "green":
            fail(f"qdrant collection '{COLLECTION_ALIAS}' status={result.get('status')}")
        print(f"qdrant OK: alias '{COLLECTION_ALIAS}' -> {result.get('config', {}).get('params', {}).get('vectors', {})}")
    except urllib.error.HTTPError as e:
        fail(f"qdrant alias '{COLLECTION_ALIAS}' does not resolve (HTTP {e.code}); "
             "has the collection been created and the alias set?")
    except Exception as e:
        fail(f"qdrant check: {e}")

    print("SMOKE TEST PASSED")


if __name__ == "__main__":
    main()
